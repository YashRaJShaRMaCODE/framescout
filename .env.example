DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local default: sqlite3. For a persistent PostgreSQL database, set these in
# the host's secret environment settings; never commit real credentials.
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=framescout
# DJANGO_DB_USER=framescout_app
# DJANGO_DB_PASSWORD=replace-with-database-secret
# DJANGO_DB_HOST=your-managed-postgres-host
# DJANGO_DB_PORT=5432
